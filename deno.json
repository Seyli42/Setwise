{
  "tasks": {
    "start": "deno run --env --allow-net --allow-env --allow-read src/server.ts",
    "dev": "deno run --env --watch --allow-net --allow-env --allow-read src/server.ts",
    "migrate": "deno run --env --allow-net --allow-env --allow-read scripts/migrate.ts",
    "seed": "deno run --env --allow-net --allow-env --allow-read scripts/seed.ts",
    "check": "deno check src/server.ts src/db.ts src/auth.ts src/_shared/*.ts src/_shared/agent/*.ts src/_shared/channels/*.ts src/_shared/calendar/*.ts",
    "lint": "deno lint src frontend/dashboard/js",
    "test": "deno test --allow-env --allow-read src/ frontend/dashboard/js",
    "fmt": "deno fmt src frontend/dashboard/js"
  },
  "imports": {
    "postgres": "npm:postgres@^3.4.5",
    "jose": "npm:jose@^5.9.6",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.36.3",
    "stripe": "npm:stripe@^17.6.0"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": [
    "frontend/dashboard/vendor",
    "frontend/site",
    "node_modules",
    "**/._*"
  ]
}
