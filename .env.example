# ============================================================
# Setwise — Variables d'environnement
# ============================================================

# 1. Base de données PostgreSQL Neon (avec pooler SSL)
# Format : postgresql://user:password@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# DEUX RÔLES depuis migrations/0006_rls_roles.sql et 0007_rls_policies.sql :
#   DATABASE_URL         -> rôle `setwise_app`    (tableau de bord, soumis à la RLS)
#   DATABASE_URL_WORKER  -> rôle `setwise_worker` (webhooks, crons, moteur d'agent — BYPASSRLS)
# Les deux rôles sont créés par la migration 0006 SANS mot de passe (secret
# hygiene : jamais dans un fichier versionné). Le fixer à la main juste après :
#   alter role setwise_app    with password '...';
#   alter role setwise_worker with password '...';
# Ne déployer le code qu'une fois les DEUX variables renseignées — voir
# l'en-tête de migrations/0007_rls_policies.sql pour l'ordre exact.
DATABASE_URL=postgresql://setwise_app:password@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_WORKER=postgresql://setwise_worker:password@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 2. Sécurité & Cryptographie
# Clé secrète de chiffrement AES-256 (32 caractères minimum, ex: openssl rand -base64 32)
ENCRYPTION_KEY=votre_cle_de_chiffrement_aes_256_bits_ici
# Secret de signature des sessions JWT
JWT_SECRET=votre_secret_pour_signature_jwt
# Jeton secret pour sécuriser l'appel des crons HTTP (/crons/*)
CRON_SECRET=votre_secret_de_declenchement_cron

# 3. Intelligence Artificielle (DeepSeek ou Anthropic)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=sk-ant-api03-...

# 4. Canaux Meta (Instagram & WhatsApp)
# Application Meta for Developers
META_APP_ID=123456789012345
META_APP_SECRET=abcdef0123456789abcdef0123456789
# Token de vérification configuré dans le webhook Meta
META_WEBHOOK_VERIFY_TOKEN=votre_token_aleatoire_verification_webhook

# 5. Calendrier Google Calendar (OAuth 2.0)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-votre_client_secret

# 6. Facturation Stripe
STRIPE_SECRET_KEY=sk_test_... (ou sk_live_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# 7. Emails & Notifications (Resend)
RESEND_API_KEY=re_123456789
NOTIFICATION_FROM="Setwise <connexion@votre-domaine.fr>"
WHATSAPP_ALERT_TEMPLATE=setwise_escalade

# 8. Serveur & Domaines autorisés
PORT=8000
DASHBOARD_ORIGIN=http://localhost:8000

# Origines autorisées pour les liens de connexion (magic link), séparées par
# des virgules. La première est l'origine canonique, utilisée par défaut et en
# repli si l'origine de la requête n'y figure pas. À défaut, DASHBOARD_ORIGIN
# ci-dessus sert de repli unique — ne pas laisser vide en production.
# APP_ORIGINS=https://dashboard.setwise.fr
DISABLE_INTERNAL_WORKER=false
